{
  "name": "feudal-lord-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "play": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort --open",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/remote/localGuard.mjs \"전체 시험 스위트(npm test)\" \"npm run remote:test\" && tsx --test tests/*.test.ts",
    "harness": "tsx scripts/economyHarness.ts",
    "verify:provenance": "tsx scripts/verifyProvenance.ts",
    "verify:save-determinism": "tsx scripts/verifySaveDeterminism.ts",
    "build:save-fixtures": "tsx scripts/buildSaveFixtures.ts",
    "save:fingerprint": "tsx scripts/saveSchemaFingerprint.ts --write",
    "remote:setup": "ssh -o BatchMode=yes ${FLS_REMOTE_HOST:-hyunlord@100.70.109.50} bash -s < scripts/remote/setup-dgx.sh",
    "remote:test": "scripts/remote/run.sh --task test",
    "remote:guardrail": "scripts/remote/run.sh --task guardrail",
    "remote:browser": "scripts/remote/run.sh --task browser",
    "remote:clone-check": "scripts/remote/run.sh --task clone-check",
    "remote:trend": "scripts/remote/run.sh --task trend",
    "perf:trend": "tsx scripts/perf/perfTrend.ts",
    "remote:perf": "scripts/remote/run.sh --task perf",
    "remote:ui-geometry": "scripts/remote/run.sh --task ui-geometry",
    "ui-geometry:baseline": "node scripts/uiGeometryBaseline.mjs",
    "perf:gate": "tsx scripts/perf/perfGate.ts",
    "perf:ab": "tsx scripts/perf/perfAB.ts",
    "telemetry:report": "tsx scripts/telemetry/report.ts",
    "hooks:install": "sh scripts/git-hooks/install.sh",
    "postinstall": "test ! -f scripts/git-hooks/install.sh || sh scripts/git-hooks/install.sh",
    "check:merge": "node scripts/checks/mergeChecks.mjs",
    "budget:dist": "node scripts/checks/distBudget.mjs --build",
    "lint": "npm --prefix tools/eslint ci --no-audit --no-fund --loglevel=error && tools/eslint/node_modules/.bin/eslint -c tools/eslint/eslint.config.mjs --suppressions-location tools/eslint/eslint-suppressions.json --max-warnings 0 src"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}

{
  "about": "Build output (dist) size budget (BUDGET-1). scripts/checks/distBudget.mjs sorts every dist file into a category by the first rule whose pattern matches its dist-relative path; a file no rule matches is counted as 기타 and listed. Budgets are in MB = 1,000,000 bytes; null = measured, no budget. check:merge fails when the total or a budgeted category is over. A category with onDemand true loads only when its screen needs it (EVENT-ART, user decision 2026-10-05: the event pictures when their card opens): it is measured, but the total — the first load — leaves it out.",
  "megabyte": 1000000,
  "totalBudgetMB": 150,
  "categories": [
    { "id": "world", "name": "세계 그림", "budgetMB": null },
    { "id": "portraits", "name": "초상", "budgetMB": 20 },
    { "id": "illustrations", "name": "삽화", "budgetMB": 25 },
    { "id": "event_cards", "name": "사건 삽화(카드에서 불러옴)", "budgetMB": null, "onDemand": true },
    { "id": "keyart", "name": "키아트", "budgetMB": null },
    { "id": "ui", "name": "UI", "budgetMB": null },
    { "id": "sound", "name": "소리", "budgetMB": null },
    { "id": "code", "name": "코드", "budgetMB": null },
    { "id": "other", "name": "기타", "budgetMB": null }
  ],
  "rules": [
    { "category": "code", "label": "page, scripts, styles, manifests", "patterns": ["index.html", "assets/*.js", "assets/*.css", "**/*.wasm", "**/*.map", "**/*.json"] },
    { "category": "code", "label": "license texts", "patterns": ["licenses/**"] },
    { "category": "sound", "label": "audio", "patterns": ["audio/**", "**/*.{mp3,ogg,wav,m4a,opus}"] },
    { "category": "portraits", "label": "portrait pool (256 and 96 px JPEG)", "patterns": ["assets/portraits/**"] },
    { "category": "portraits", "label": "steward portraits (P0)", "patterns": ["assets/ui-p0/advisor_steward_portrait_*", "assets/ui-p0/portraits/advisor_steward_portrait_*"] },
    { "category": "keyart", "label": "title, mode select, emblem, loading screens (Wave 8)", "patterns": ["assets/wave8/keyart/**"] },
    { "category": "illustrations", "label": "events, decisions, chronicle, chapter pages (Wave 16)", "patterns": ["assets/wave16/**"] },
    { "category": "illustrations", "label": "chapter 2 end, chronicle, decisions, events (Wave 17)", "patterns": ["assets/wave17/*.{jpg,png}", "assets/wave17/{chronicle,decision,event}/**"] },
    { "category": "illustrations", "label": "season ledger scenes (Wave 19)", "patterns": ["assets/wave19/scenes_*/**"] },
    { "category": "illustrations", "label": "chapter 3–5 art: decisions, events, chronicle, chapter and campaign end (Wave 21)", "patterns": ["assets/wave21/**"] },
    { "category": "illustrations", "label": "chapter 5 interlude events, 1384–1400 (Wave 33)", "patterns": ["assets/wave33/**"] },
    { "category": "illustrations", "label": "the campaign's six ending paintings (INSTALL-33)", "patterns": ["assets/endings/**"] },
    { "category": "event_cards", "label": "the registry's event pictures (only the registry's entries) and Wave 40's lord-mode moments, re-encoded at build (EVENT-ART)", "patterns": ["assets/event-art/**", "assets/wave40/**"] },
    { "category": "ui", "label": "fonts (Noto Sans KR, Noto Serif KR; woff2 only)", "patterns": ["assets/*.{woff,woff2,ttf,otf}"] },
    { "category": "ui", "label": "P0 kit: frames, textures, icons, cursors, buttons", "patterns": ["assets/ui/**", "assets/ui-p0/**"] },
    { "category": "ui", "label": "Wave 8 frames, icons, ornaments, time strip", "patterns": ["assets/wave8/{frames,icons,ornaments,time}/**"] },
    { "category": "ui", "label": "heraldry, merchant marks, seals, UI frames and icons (Wave 14)", "patterns": ["assets/wave14/**"] },
    { "category": "ui", "label": "the lord screens' UI parts (LM-R2 frames, icons, cards through the art contract)", "patterns": ["assets/lord-ui/**"] },
    { "category": "ui", "label": "record cards, chronicle pages, timeline (Wave 19)", "patterns": ["assets/wave19/{cards,pages,timeline}/**"] },
    { "category": "ui", "label": "pad glyphs, person-state ornaments, royal arms (Wave 23)", "patterns": ["assets/wave23/{pad,person_state,royal}/**"] },
    { "category": "ui", "label": "family tree parts (Wave 25)", "patterns": ["assets/wave25/tree/**"] },
    { "category": "world", "label": "buildings, walls, gates, bridges, modules", "patterns": ["assets/{buildings,wall,complete-art-v1,module,phase16-house-condition,runtime-construction-v1}/**"] },
    { "category": "world", "label": "terrain, water, shore, roads, fields, foliage, boundaries, zones, yards", "patterns": ["assets/{terrain,water,shore,road,fields,foliage,boundary,phase16-landscape,zones,yards}/**"] },
    { "category": "world", "label": "walkers, animals, carried props", "patterns": ["assets/{walkers-v2,walker-props-v1,runtime-actors-v1}/**"] },
    { "category": "world", "label": "visible simulation marks (visibility v1)", "patterns": ["assets/visibility-v1/**"] },
    { "category": "world", "label": "world waves 7, 9, 11, 12, 15", "patterns": ["assets/{wave7,wave9,wave11,wave12,wave15}/**"] },
    { "category": "world", "label": "war props (Wave 17 world)", "patterns": ["assets/wave17/world/**"] },
    { "category": "world", "label": "village life, weather (Wave 23)", "patterns": ["assets/wave23/{life_birds,life_ground,life_props,weather}/**"] },
    { "category": "world", "label": "house variants and their state layers (Wave 26)", "patterns": ["assets/wave26/**"] },
    { "category": "world", "label": "pair-house variants and their state layers (Wave 30)", "patterns": ["assets/wave30/**"] },
    { "category": "world", "label": "countryside outside the walls: field-edge strips, point props, wildflower patches (Wave 28)", "patterns": ["assets/wave28/**"] },
    { "category": "world", "label": "backyard decals (Wave 27)", "patterns": ["assets/wave27/yards/**"] },
    { "category": "world", "label": "water motion (Wave 29)", "patterns": ["assets/wave29/water/**"] },
    { "category": "world", "label": "granary variants and their state layers, granary props (Wave 32)", "patterns": ["assets/wave32/**"] }
  ]
}

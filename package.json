{
  "name": "feudal-lord-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "play": "vite build && vite preview --host 127.0.0.1 --port 4173 --strictPort --open",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "harness": "tsx scripts/economyHarness.ts",
    "verify:provenance": "tsx scripts/verifyProvenance.ts",
    "verify:save-determinism": "tsx scripts/verifySaveDeterminism.ts",
    "build:save-fixtures": "tsx scripts/buildSaveFixtures.ts",
    "save:fingerprint": "tsx scripts/saveSchemaFingerprint.ts --write",
    "remote:setup": "ssh -o BatchMode=yes ${FLS_REMOTE_HOST:-hyunlord@100.70.109.50} bash -s < scripts/remote/setup-dgx.sh",
    "remote:test": "scripts/remote/run.sh --task test",
    "remote:guardrail": "scripts/remote/run.sh --task guardrail",
    "remote:browser": "scripts/remote/run.sh --task browser",
    "remote:clone-check": "scripts/remote/run.sh --task clone-check",
    "remote:perf": "scripts/remote/run.sh --task perf",
    "hooks:install": "sh scripts/git-hooks/install.sh",
    "postinstall": "test ! -f scripts/git-hooks/install.sh || sh scripts/git-hooks/install.sh"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:astra:current-param-proposed-variants:r06",
  "title": "LM-E9 반영 연대기 문구 후보: 182 template·46 원장분류",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "sourceHead",
    "selection",
    "historyKinds",
    "historyTemplates",
    "ledgerCategories",
    "slots"
  ],
  "properties": {
    "schemaVersion": {
      "const": "steward-chronicle-draft-1"
    },
    "status": {
      "const": "candidate_not_installed"
    },
    "sourceHead": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "historyKinds": {
      "type": "array",
      "items": {
        "enum": [
          "decision",
          "event",
          "person",
          "faction",
          "era",
          "milestone",
          "ledger"
        ]
      },
      "uniqueItems": true
    },
    "historyTemplates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "template",
          "source",
          "baseline",
          "variants"
        ],
        "properties": {
          "template": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "baseline": {
            "type": "object",
            "required": [
              "renderer",
              "arguments",
              "required"
            ],
            "properties": {
              "renderer": {
                "const": "history.summary"
              },
              "arguments": {
                "const": [
                  "record",
                  "state"
                ]
              },
              "required": {
                "const": true
              }
            }
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/variant"
            }
          }
        }
      },
      "minItems": 182,
      "maxItems": 182
    },
    "ledgerCategories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "label",
          "source",
          "variants"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/variant"
            }
          }
        }
      },
      "minItems": 46,
      "maxItems": 46
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "required": [
        "field",
        "op",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(params\\.[A-Za-z_]+|entry\\.(account|amount)|date\\.year)$"
        },
        "op": {
          "enum": [
            "eq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "neq"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "array"
          ]
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "when"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          }
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "requiredSlots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "retainFactLine": {
          "const": true
        }
      },
      "anyOf": [
        {
          "required": [
            "headline"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ]
    }
  }
}
